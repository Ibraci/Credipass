# CREDIPASS R19.3.2 — configuration locale (copier en .env.local)
CREDIPASS_DATABASE_URL=postgresql://credipass:CHANGE_ME@127.0.0.1:5432/credipass
CREDIPASS_PG_SSL=disable
CREDIPASS_PG_POOL=10
CREDIPASS_HOST=127.0.0.1

# IA connectée — facultatif. L'assistant local reste disponible hors connexion.
# CREDIPASS_AI_BASE_URL=https://votre-fournisseur/v1
# CREDIPASS_AI_MODEL=votre-modele
# CREDIPASS_AI_API_KEY=...
# CREDIPASS_AI_PROVIDER=OpenAI-compatible

# Comptes de démonstration : mots de passe simples par rôle.
# Vous pouvez surcharger un compte individuellement, par exemple :
# CREDIPASS_PASSWORD_AGENT_CREDIT=VotreMotDePasse
# Compatibilité tests/ancienne configuration : CREDIPASS_DEMO_PASSWORD peut encore imposer un mot de passe commun.
