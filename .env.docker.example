# CREDIPASS — configuration Docker (copier en .env à la racine du projet)
POSTGRES_DB=credipass
POSTGRES_USER=credipass
# Obligatoire. Exemple pour en générer un : openssl rand -hex 24
POSTGRES_PASSWORD=

# Port et interface d'écoute sur la machine hôte.
CREDIPASS_PORT=8092
CREDIPASS_BIND=127.0.0.1

# 1 = remet les mots de passe de démonstration à chaque démarrage (hackathon uniquement).
CREDIPASS_RESET_DEMO_PASSWORDS=1

# IA connectée — facultatif.
# CREDIPASS_AI_BASE_URL=https://votre-fournisseur/v1
# CREDIPASS_AI_MODEL=votre-modele
# CREDIPASS_AI_API_KEY=...
# CREDIPASS_AI_PROVIDER=OpenAI-compatible
